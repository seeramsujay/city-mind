# CityMind Environment Variables Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database Settings
DATABASE_URL=postgresql://user:password@localhost:5432/citymind
REDIS_URL=redis://localhost:6379/0
TIMESCALE_URL=postgresql://user:password@localhost:5432/citymind_telemetry

# MQTT Broker (IoT Ingestion)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=citymind/sensors

# AI & Vector Store Settings
OPENAI_API_KEY=your_openai_api_key_here
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
