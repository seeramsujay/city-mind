# CityMind Environment Variables Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database Settings
DATABASE_URL=postgresql://user:password@localhost:5432/citymind
REDIS_URL=redis://localhost:6379/0
TIMESCALE_URL=postgresql://user:password@localhost:5432/citymind_telemetry

# MQTT Broker (IoT Ingestion)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=citymind/sensors

# Google Gemini Free Tier AI Settings (Free Forever API Key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.1-flash-lite

# Vector & Graph Storage Settings
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# CockroachDB Distributed Vector Indexing & Cloud MCP Server (Free Tier Cluster)
COCKROACH_DATABASE_URL=postgresql://root@localhost:26257/citymind?sslmode=disable
COCKROACH_VECTOR_DIMENSION=384
COCKROACH_MCP_ENDPOINT=https://cockroachlabs.cloud/mcp

# AWS Forever Free Tier Services (100% Zero-Cost Always Free Tier - NO Bedrock, NO Paid APIs)
# - Amazon DynamoDB: 25 GB Storage, 25 WCU, 25 RCU (Free Forever)
# - Amazon SNS: 1,000,000 Push Notifications / Month (Free Forever)
# - Amazon SQS: 1,000,000 Requests / Month (Free Forever)
# - AWS Lambda: 1,000,000 Invocations & 3.2M Compute-Seconds / Month (Free Forever)
# - Amazon CloudWatch: 10 Custom Alarms, 5GB Ingestion / Month (Free Forever)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=
AWS_DYNAMODB_TABLE_NAME=citymind-commits
AWS_SNS_CRITICAL_ALERTS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:citymind-critical-alerts
AWS_SQS_TELEMETRY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/citymind-telemetry-queue
AWS_S3_BUCKET_NAME=citymind-event-memory-archive

# Frontend Production API URL (for Vercel deployment)
# VITE_API_BASE_URL=https://your-backend-api.example.com/api/v1
